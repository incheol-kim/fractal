# Text files are stored with LF line endings whatever the editor or tool wrote,
# so a commit never shows a whole file as changed because of line endings.
* text=auto eol=lf

# Source material and archived snapshots are kept byte for byte.
resources/** -text
docs/archive/** -text

# Binary material.
*.png binary
*.webp binary
*.jpg binary
*.wav binary
*.mp3 binary
*.flac binary
*.mid binary
*.song binary
*.npz binary
*.safetensors binary
*.ttf binary
